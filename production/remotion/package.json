    "render:sc001-005": "npm run assets:sync && remotion render ANAADHI-SC001-SC005-SOURCE-REVIEW-4K-SCOPE out/ANAADHI_SC001_SC005_SOURCE_REVIEW_4K_SCOPE.mp4 --codec=h264 --crf=18",
    "render:sc001-005-preview": "npm run assets:sync && remotion render ANAADHI-SC001-SC005-SOURCE-REVIEW-4K-SCOPE out/ANAADHI_SC001_SC005_SOURCE_REVIEW_1920x800.mp4 --codec=h264 --crf=20 --scale=0.5",
    "still:sc001-005": "npm run assets:sync && remotion still ANAADHI-SC001-SC005-SOURCE-REVIEW-4K-SCOPE out/ANAADHI_SC001_SC005_QA_FRAME.jpg --frame=4935 --image-format=jpeg",
    "render:reel1": "remotion render ANAADHI-REEL-01",
    "render:reel2": "remotion render ANAADHI-REEL-02",
    "render:reel3": "remotion render ANAADHI-REEL-03",
    "render:reel4": "remotion render ANAADHI-REEL-04",
    "render:reel5": "remotion render ANAADHI-REEL-05"
