  "dependencies": {
    "@remotion/cli": "^4.0.506",
    "@remotion/media": "^4.0.506",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.506"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
