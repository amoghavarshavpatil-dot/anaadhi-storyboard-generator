{
  "name": "anaadhi-remotion-storyboard-audiobook",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "assets:sync": "node scripts/sync-canon-assets.mjs",
    "studio": "npm run assets:sync && remotion studio",
