{
  "name": "anaadhi-remotion-storyboard-audiobook",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "verify:approved-shots": "node scripts/verify-approved-shots.mjs",
    "validate": "npm run verify:approved-shots && npm run typecheck && npm run compositions",
    "render": "remotion render ANAADHI-STORYBOARD-AUDIOBOOK-4K-SCOPE",
    "render:sc001-approved": "remotion render ANAADHI-SC001-APPROVED-V001",
    "render:reel1": "remotion render ANAADHI-SOURCE-REVIEW-01",
    "render:reel2": "remotion render ANAADHI-SOURCE-REVIEW-02",
    "render:reel3": "remotion render ANAADHI-SOURCE-REVIEW-03",
    "render:reel4": "remotion render ANAADHI-SOURCE-REVIEW-04",
    "render:reel5": "remotion render ANAADHI-SOURCE-REVIEW-05"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.506",
    "@remotion/media": "^4.0.506",
    "remotion": "^4.0.506",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
