{
  "name": "anaadhi-remotion-storyboard-audiobook",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "verify:approved-shots": "node scripts/verify-approved-shots.mjs",
    "validate": "npm run verify:approved-shots && npm run typecheck && npm run compositions",
    "render": "remotion render ANAADHI_STORYBOARD_AUDIOBOOK_4K_SCOPE",
    "render:sc001-approved": "remotion render ANAADHI_SC001_APPROVED_V001",
    "render:reel1": "remotion render ANAADHI_REEL_01",
    "render:reel2": "remotion render ANAADHI_REEL_02",
    "render:reel3": "remotion render ANAADHI_REEL_03",
    "render:reel4": "remotion render ANAADHI_REEL_04",
    "render:reel5": "remotion render ANAADHI_REEL_05"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.506",
    "@remotion/media": "^4.0.506",
    "remotion": "^4.0.506",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
