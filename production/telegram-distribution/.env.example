# Runtime
PORT=8000
PUBLIC_BASE_URL=https://your-stable-domain.example
DATA_FILE=/data/anaadhi-telegram-distribution.json

# Protect /mcp in production. Leave empty only during a private local test.
MCP_ACCESS_TOKEN=replace-with-a-long-random-value

# Created through Telegram's official @BotFather account.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token
TELEGRAM_BOT_USERNAME=ANAADHIReleaseBot

# Official public channel username, without @.
TELEGRAM_CHANNEL_USERNAME=ANAADHITheEpic

# Random 1-256 character secret sent by Telegram in the webhook header.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-separate-random-value

# Stay below Telegram's ordinary free broadcast ceiling.
BROADCAST_PER_SECOND=25
